<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_activities"
    app:startDestination="@id/habitSettingActivity">

    <activity
        android:id="@+id/habitSettingActivity"
        android:name="edu.ph.iota.activities.HabitSettingActivity"
        android:label="activity_habit_setting"
        tools:layout="@layout/activity_habit_setting">
        <action
            android:id="@+id/from_habit_setting_to_home"
            app:destination="@id/homeActivity2" />
    </activity>


    <activity
        android:id="@+id/homeActivity2"
        android:name="edu.ph.iota.activities.HomeActivity"
        android:label="activity_home"
        tools:layout="@layout/activity_home" />

</navigation>