<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_onboarding"
    app:startDestination="@id/onboardingFragment">

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="edu.ph.iota.fragments.OnboardingFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboarding_to_createFirstHabit"
            app:destination="@id/createFirstHabitFragment" />
    </fragment>

    <fragment
        android:id="@+id/createFirstHabitFragment"
        android:name="edu.ph.iota.fragments.CreateFirstHabitFragment"
        android:label="Create First Habit"
        tools:layout="@layout/fragment_create_first_habit">
        <action
            android:id="@+id/action_createFirstHabit_to_habitTemplate"
            app:destination="@id/habitTemplateFragment" />
    </fragment>

    <fragment
        android:id="@+id/habitTemplateFragment"
        android:name="edu.ph.iota.fragments.HabitTemplateFragment"
        android:label="Habit Template"
        tools:layout="@layout/fragment_habit_template">
        <action
            android:id="@+id/action_habitTemplate_to_habitSettings"
            app:destination="@id/onboardingFragment" />
    </fragment>
</navigation>