<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:flexWrap="wrap"
        app:justifyContent="flex_start"
        app:alignItems="center"
        android:layout_margin="35dp"
        app:flexDirection="row"
        app:layout_flexGrow="1"
        >


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I will"
            android:fontFamily="@font/lusitana"
            android:textSize="25dp"
            android:textColor="@color/brown"/>

        <EditText
            android:id="@+id/editTextHabit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lusitana"
            android:hint="habit"
            android:backgroundTint="@color/orange"
            android:textSize="25dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=","
            android:textSize="25dp"
            android:textColor="@color/lightgray"
            android:fontFamily="@font/lusitana"
            />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_flexBasisPercent="100%" />

        <EditText
            android:id="@+id/editTextLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="time/location"
            android:textSize="25dp"
            android:backgroundTint="@color/orange"
            android:fontFamily="@font/lusitana"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="so that I can become"
            android:textSize="25dp"
            android:textColor="@color/brown"
            android:fontFamily="@font/lusitana"/>

        <EditText
            android:id="@+id/editTextIdentity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="25dp"
            android:backgroundTint="@color/orange"
            android:hint="type of person you want to be"
            android:fontFamily="@font/lusitana"/>
    </com.google.android.flexbox.FlexboxLayout>

    <LinearLayout
        android:id="@+id/aiLoadingRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="35dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            style="?android:progressBarStyleSmall"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Checking your habit…"
            android:textSize="13sp"
            android:textColor="@color/gray"
            android:fontFamily="@font/lusitana"/>

    </LinearLayout>

    <!--  AI feedback-->
    <!--GONE by default.-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/aiFeedbackCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="35dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAiIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:text="✅"/>

                <!-- One-sentence reason from AI -->
                <TextView
                    android:id="@+id/tvAiReason"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/lusitana"
                    android:textColor="@color/darkbrown"/>

            </LinearLayout>

            <!-- Suggested rewrite this is only visible when invalid -->
            <TextView
                android:id="@+id/tvAiSuggestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:fontFamily="@font/lusitana"
                android:textColor="@color/gray"
                android:textStyle="italic"
                android:visibility="gone"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</LinearLayout>