<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="match_parent">


    <LinearLayout
        android:paddingHorizontal="10dp"
        android:layout_width="match_parent"
        android:layout_gravity="center_horizontal"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/textView"
            android:textStyle="bold"
            android:paddingRight="80dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:text="Repeat" />

        <TextView
            android:id="@+id/textView2"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:gravity="right"
            android:text="Choose at least 1 day" />
    </LinearLayout>


    <com.google.android.material.chip.ChipGroup
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_gravity="center_horizontal"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sun"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="S"
            android:checkable="true"
            android:gravity="center"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="18sp"
            android:padding="0dp"
            android:minLines="1"
            app:chipCornerRadius="20dp"
            app:chipBackgroundColor="@color/chip_bg_selector"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_mon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="M"
            android:checkable="true"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:minLines="1"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/chip_bg_selector"
            app:chipCornerRadius="20dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_tue"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="T"
            android:checkable="true"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:minLines="1"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/chip_bg_selector"
            app:chipCornerRadius="20dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_wed"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="W"
            android:checkable="true"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:minLines="1"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/chip_bg_selector"
            app:chipCornerRadius="20dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_thu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="T"
            android:checkable="true"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:minLines="1"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/chip_bg_selector"
            app:chipCornerRadius="20dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_fri"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="F"
            android:checkable="true"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:minLines="1"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/chip_bg_selector"
            app:chipCornerRadius="20dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_sat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="S"
            android:checkable="true"
            android:gravity="center"
            android:textAlignment="center"
            android:padding="0dp"
            android:minLines="1"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/chip_bg_selector"
            app:chipCornerRadius="20dp"
            app:chipStartPadding="0dp"
            app:chipEndPadding="0dp"
            app:ensureMinTouchTargetSize="false"/>

    </com.google.android.material.chip.ChipGroup>

</LinearLayout>