<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTutorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lusitana_bold"
        android:text="Tutorial"
        android:textColor="#706A61"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/lusitana"
        android:text="1/3"
        android:textColor="#706A61"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTutorial" />

    <TextView
        android:id="@+id/tvSubHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/lusitana"
        android:text="How to create a habit"
        android:textColor="#706A61"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTutorial" />

    <ImageView
        android:id="@+id/ivStepImage"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/circle_step1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubHeader" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/lusitana_bold"
        android:text="Define your habit"
        android:textColor="#706A61"
        android:textSize="26sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivStepImage" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/lusitana"
        android:lineSpacingExtra="6dp"
        android:textColor="#8E887E"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvHabitCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescription">

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/tutorialFlexContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="32dp"
            app:flexWrap="wrap"
            app:flexDirection="row"
            app:justifyContent="flex_start"
            app:alignItems="baseline">

            <TextView
                android:id="@+id/tvPart1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I will "
                android:fontFamily="@font/lusitana"
                android:textSize="20sp"
                android:textColor="#BCB6AF" />

            <TextView
                android:id="@+id/tvHighlightedPart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="meditate for 5 mins,"
                android:fontFamily="@font/lusitana"
                android:textSize="20sp"
                android:textColor="@color/brown"
                android:background="@drawable/tinted_underline"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/tvPart2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="when I wake up so that I can become a mindful person."
                android:fontFamily="@font/lusitana"
                android:textSize="20sp"
                android:textColor="#BCB6AF" />

        </com.google.android.flexbox.FlexboxLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkip"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/lusitana"
        android:text="Skip"
        android:textAllCaps="false"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="24dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:text="Next"
        android:fontFamily="@font/lusitana"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="#613000"
        app:cornerRadius="24dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>