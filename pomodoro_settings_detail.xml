<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="350dp"
    android:layout_height="350dp"
    android:layout_gravity="center"
    app:cardBackgroundColor="#4C463D"
    app:cardCornerRadius="32dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/pomodoro_detail_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/pomodoro_circle_outline"
            android:contentDescription="Back"
            android:src="@drawable/pomodorobackarrow" />

        <LinearLayout
            android:id="@+id/center_value_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pomodoro_detail_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="25"
                android:textColor="#FFFFFF"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="min"
                android:textColor="#D9D2C5"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pomodoro_detail_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/center_value_layout"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif"
            android:text="Focus Session"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/pomodoro_detail_minus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/center_value_layout"
            android:layout_marginEnd="24dp"
            android:background="@drawable/pomodoro_circle_outline"
            android:gravity="center"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/pomodoro_detail_plus"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/center_value_layout"
            android:layout_marginStart="24dp"
            android:background="@drawable/pomodoro_circle_outline"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>