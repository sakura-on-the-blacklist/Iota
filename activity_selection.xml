<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pommy">

    <include
        android:id="@+id/select_mon"
        layout="@layout/item_day_selectable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2.5dp"
        app:layout_constraintBottom_toTopOf="@id/btn_continue"
        app:layout_constraintEnd_toStartOf="@+id/select_tue"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/select_tue"
        layout="@layout/item_day_selectable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_mon"
        app:layout_constraintEnd_toStartOf="@+id/select_wed"
        app:layout_constraintStart_toEndOf="@+id/select_mon"
        app:layout_constraintTop_toTopOf="@+id/select_mon" />

    <include
        android:id="@+id/select_wed"
        layout="@layout/item_day_selectable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_mon"
        app:layout_constraintEnd_toStartOf="@+id/select_thu"
        app:layout_constraintStart_toEndOf="@+id/select_tue"
        app:layout_constraintTop_toTopOf="@+id/select_mon" />

    <include
        android:id="@+id/select_thu"
        layout="@layout/item_day_selectable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_mon"
        app:layout_constraintEnd_toStartOf="@+id/select_fri"
        app:layout_constraintStart_toEndOf="@+id/select_wed"
        app:layout_constraintTop_toTopOf="@+id/select_mon" />

    <include
        android:id="@+id/select_fri"
        layout="@layout/item_day_selectable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_mon"
        app:layout_constraintEnd_toStartOf="@+id/select_sat"
        app:layout_constraintStart_toEndOf="@+id/select_thu"
        app:layout_constraintTop_toTopOf="@+id/select_mon" />

    <include
        android:id="@+id/select_sat"
        layout="@layout/item_day_selectable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_mon"
        app:layout_constraintEnd_toStartOf="@+id/select_sun"
        app:layout_constraintStart_toEndOf="@+id/select_fri"
        app:layout_constraintTop_toTopOf="@+id/select_mon" />

    <include
        android:id="@+id/select_sun"
        layout="@layout/item_day_selectable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/select_mon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/select_sat"
        app:layout_constraintTop_toTopOf="@+id/select_mon" />

    <Button
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="64dp"
        android:backgroundTint="#FFFFFF"
        android:text="Continue"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>